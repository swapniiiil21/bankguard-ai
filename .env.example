# ============================================================
# BankGuard AI — Environment Variables
# Copy this file to .env and fill in your credentials
# ============================================================

# LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Vector Store (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=your_pinecone_environment       # e.g., us-east-1-aws
PINECONE_INDEX=bankguard-fraud-cases

# HuggingFace Embeddings
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# AWS Textract (OCR fallback)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1

# MongoDB
MONGO_URI=mongodb://mongo:27017/bankguard

# Application Settings
FRAUD_SCORE_THRESHOLD=70
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
